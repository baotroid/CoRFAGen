<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads a DWG/DXF for the skill: sheet PNG, exact data as text, all lines as CSV. CadDrawingReader.cs is copied from the add-in on its build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ACadSharp" Version="3.8.35" />
  </ItemGroup>
</Project>
