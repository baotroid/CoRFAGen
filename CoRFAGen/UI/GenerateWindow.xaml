<Window x:Class="CoRFAGen.UI.GenerateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CoRFAGen - Generate"
        Width="560"
        Height="880"
        MinWidth="440"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CoRFAGenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0"
                    Padding="16,10" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                            <Run Text="Co" Foreground="{StaticResource AccentBrush}"/><Run Text="RFAGen"/>
                        </TextBlock>
                        <TextBlock Text="&#x00B7;" FontSize="13" Foreground="{StaticResource AccentBrush}"
                                   VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Text="Generate" FontSize="11"
                                   Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="BtnClose_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="&#x2715;" FontSize="11" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#E07B1F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="28,20,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0 header -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>  <!-- 2 files -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>  <!-- 4 family name -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>  <!-- 6 context -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>  <!-- 8 provider/model -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>  <!-- 10 checks -->
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>  <!-- 12 progress -->
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>  <!-- 14 buttons -->
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Select up to 3 source files of ONE object: a DWG/DXF or PDF drawing (2+ views, technical data), a JPG photo and/or a PNG hand sketch."/>

                <!-- Files -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Source files (max 3: DWG / DXF / PDF / JPG / PNG)" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CoRFAGenBorderBrush}"
                                BorderThickness="1" CornerRadius="4" Padding="10,7">
                            <TextBlock x:Name="TxtFilePath" Text="No files selected"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button x:Name="BtnBrowse" Grid.Column="1" Content="Add files..."
                                Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                        <Button x:Name="BtnClearFiles" Grid.Column="2" Content="Clear"
                                Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BtnClearFiles_Click"/>
                    </Grid>
                    <Border x:Name="PreviewBorder" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CoRFAGenBorderBrush}" BorderThickness="1" CornerRadius="4"
                            Margin="0,10,0,0" Padding="8" Visibility="Collapsed">
                        <StackPanel>
                            <Image x:Name="ImagePreview" MaxHeight="140" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="TxtFileList" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Family name -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="Family name (optional)" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtFamilyName" MaxLength="100"/>
                </StackPanel>

                <!-- Context -->
                <StackPanel Grid.Row="6">
                    <TextBlock Text="Additional context (optional)" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtContext" AcceptsReturn="True" TextWrapping="Wrap" Height="56"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"/>
                </StackPanel>

                <!-- Provider / model -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="AI provider" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbProvider" SelectionChanged="CmbProvider_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Model" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbModel" IsEditable="True"/>
                    </StackPanel>
                </Grid>

                <!-- Checks -->
                <StackPanel Grid.Row="10">
                    <CheckBox x:Name="ChkCheckInput" IsChecked="True"
                              Content="Check source data for conflicting dimensions and ask me"/>
                    <CheckBox x:Name="ChkVerify" IsChecked="True" Margin="0,6,0,0"
                              Content="Verify the model against the source files before preview"/>
                    <CheckBox x:Name="ChkUseFamilyParams" Margin="0,10,0,0"
                              Content="Fill the parameters of this family / template (same names and language)"
                              ToolTip="Technical data and dimensions are written into matching parameters of the open family or template; new parameters get names in its language (Russian / English). Existing parameters are kept."/>
                    <CheckBox x:Name="ChkUseSharedFile" Margin="0,6,0,0"
                              Content="Use parameters from a shared parameter file (ФОП)"
                              Checked="ChkUseSharedFile_Changed" Unchecked="ChkUseSharedFile_Changed"
                              ToolTip="Matching values are added to the family as shared parameters from this file."/>
                    <Grid x:Name="SharedFilePanel" Margin="22,6,0,0" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtSharedFile" Grid.Column="0" IsReadOnly="True" Text="No file selected"/>
                        <Button x:Name="BtnBrowseShared" Grid.Column="1" Content="Browse..." Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0" Click="BtnBrowseShared_Click"/>
                    </Grid>
                    <TextBlock x:Name="TxtParamInfo" Margin="22,4,0,0" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DisabledTextBrush}"/>
                </StackPanel>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" Grid.Row="12" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Height="4" Background="{StaticResource SurfaceBrush}"
                                 Foreground="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatusLabel" Text="Working..." TextWrapping="Wrap"
                               Foreground="{StaticResource YellowBrush}" FontSize="12"/>
                </StackPanel>

                <!-- Buttons -->
                <Grid Grid.Row="14">
                    <Button x:Name="BtnLoadJson" Content="Load JSON..." Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Click="BtnLoadJson_Click"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="BtnCancel_Click" IsCancel="True"/>
                        <Button x:Name="BtnGenerate" Content="Generate" Style="{StaticResource PrimaryButton}"
                                Click="BtnGenerate_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
