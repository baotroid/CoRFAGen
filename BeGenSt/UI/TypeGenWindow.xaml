<Window x:Class="BeGenSt.UI.TypeGenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFAGen - TypeGen"
        Width="1100"
        Height="900"
        MinWidth="820"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RFAGenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#303337"/>
                <Setter Property="Foreground" Value="#FFD27A"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="6,4"/>
                <Setter Property="BorderBrush" Value="#6A7078"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Background="{StaticResource TitleBarBrush}" CornerRadius="8,8,0,0" Padding="16,10" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center">
                            <Run Text="RFA"/><Run Text="|" Foreground="{StaticResource AccentBrush}"/><Run Text="Gen"/>
                        </TextBlock>
                        <TextBlock Text="&#x00B7;" FontSize="13" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="10,0"/>
                        <TextBlock Text="BeGenSt  ·  PDF&amp;Pic2RFA  ·  TypeGen — family types from a catalog table" FontSize="11"
                                   Foreground="{StaticResource YellowBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="BtnCancel_Click" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="&#x2715;" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background" Value="#E07B1F"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="24,16,24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- 0 files + provider -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>  <!-- 2 step 1 -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="*"/>     <!-- 4 table -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>  <!-- 6 figure / names -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>  <!-- 8 step 2 + check -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>  <!-- 10 progress -->
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="Auto"/>  <!-- 12 buttons -->
                </Grid.RowDefinitions>

                <!-- Files + provider -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Catalog sheet(s): PDF or DWG/DXF with the type table + drawing (max 3 files)" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RFAGenBorderBrush}"
                                    BorderThickness="1" CornerRadius="4" Padding="10,7">
                                <TextBlock x:Name="TxtFiles" Text="No files selected" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                            </Border>
                            <Button x:Name="BtnBrowse" Grid.Column="1" Content="Add files..." Style="{StaticResource GhostButton}"
                                    Margin="8,0,0,0" Click="BtnBrowse_Click"/>
                            <Button x:Name="BtnClearFiles" Grid.Column="2" Content="Clear" Style="{StaticResource GhostButton}"
                                    Margin="6,0,0,0" Click="BtnClearFiles_Click"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="AI provider" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbProvider" SelectionChanged="CmbProvider_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Model" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbModel" IsEditable="True"/>
                    </StackPanel>
                </Grid>

                <!-- Step 1 -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnExtract" Content="1 · Read type table" Style="{StaticResource PrimaryButton}"
                            Click="BtnExtract_Click" IsEnabled="False"/>
                    <TextBox x:Name="TxtContext" Grid.Column="2" VerticalContentAlignment="Center"
                             ToolTip="Optional notes for the AI, e.g. which table / page to use"
                             Text=""/>
                </Grid>

                <!-- Type table -->
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Types (one row = one Revit type; untick rows to skip, values are editable)" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnAllRows" Content="All" Style="{StaticResource GhostButton}" Click="BtnAllRows_Click"/>
                            <Button x:Name="BtnNoRows" Content="None" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Click="BtnNoRows_Click"/>
                        </StackPanel>
                    </DockPanel>
                    <DataGrid x:Name="GridTypes" Grid.Row="1" AutoGenerateColumns="True" CanUserAddRows="False"
                              CanUserDeleteRows="True" HeadersVisibility="Column" SelectionUnit="CellOrRowHeader"
                              Background="#2E3136" RowBackground="#3B3E43" AlternatingRowBackground="#43474D"
                              Foreground="White" BorderBrush="{StaticResource RFAGenBorderBrush}"
                              HorizontalGridLinesBrush="#555A61" VerticalGridLinesBrush="#555A61"
                              ColumnHeaderStyle="{StaticResource GridHeader}" FontSize="12"
                              CellEditEnding="GridTypes_CellEditEnding"
                              AutoGeneratingColumn="GridTypes_AutoGeneratingColumn"/>
                </Grid>

                <!-- Figure / naming -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Figure / designation" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <ComboBox x:Name="CmbFigure" IsEditable="True" SelectionChanged="CmbFigure_SelectionChanged"
                                  LostFocus="Naming_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Prefix" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtPrefix" TextChanged="Naming_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock x:Name="LblPattern" Text="Type name pattern" Margin="0,0,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtPattern" Text="{}{Префикс} {Обозначение} DN{DN} PN{PN}" TextChanged="Naming_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                        <CheckBox x:Name="ChkActuator" IsChecked="True" Content="Actuator with instance toggle"
                                  ToolTip="Actuator / drive elements are hidden by the instance yes/no parameter (Показать_привод)."/>
                        <CheckBox x:Name="ChkConnectors" IsChecked="True" Content="Pipe connectors (DN) · Pipe Accessories" Margin="0,6,0,0"
                                  ToolTip="Two pipe connectors (system Global) on the end faces at ±L/2, diameter = DN of the type. A Generic Model family is switched to the Pipe Accessories category, part type Valve - Breaks Into."/>
                        <CheckBox x:Name="ChkLookup" IsChecked="True" Content="Lookup table (size_lookup by DN, PN)" Margin="0,6,0,0"
                                  ToolTip="Embeds the table as the lookup table BGS_Catalog (Manage Lookup Tables) and drives the numeric type parameters by size_lookup on DN and PN. Every type is still created."/>
                    </StackPanel>
                </Grid>

                <!-- Step 2 + checks -->
                <Grid Grid.Row="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnTemplate" Content="2 · Generate model" Style="{StaticResource PrimaryButton}"
                            Click="BtnTemplate_Click" IsEnabled="False" VerticalAlignment="Top"/>
                    <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource RFAGenBorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,6" MaxHeight="110">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtCheck" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="Model check: no template yet."/>
                        </ScrollViewer>
                    </Border>
                    <ComboBox x:Name="CmbPreviewType" Grid.Column="4" VerticalAlignment="Top"/>
                    <Button x:Name="BtnPreview" Grid.Column="6" Content="3D preview" Style="{StaticResource SecondaryButton}"
                            Click="BtnPreview_Click" IsEnabled="False" VerticalAlignment="Top"/>
                </Grid>

                <!-- Progress -->
                <StackPanel x:Name="ProgressPanel" Grid.Row="10" Visibility="Collapsed">
                    <ProgressBar IsIndeterminate="True" Height="4" Background="{StaticResource SurfaceBrush}"
                                 Foreground="{StaticResource AccentBrush}" BorderThickness="0" Margin="0,0,0,6"/>
                    <TextBlock x:Name="StatusLabel" Text="Working..." TextWrapping="Wrap" Foreground="{StaticResource YellowBrush}" FontSize="12"/>
                </StackPanel>

                <!-- Buttons -->
                <Grid Grid.Row="12">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Button x:Name="BtnLoad" Content="Load catalog JSON..." Style="{StaticResource GhostButton}" Click="BtnLoad_Click"/>
                        <Button x:Name="BtnSave" Content="Save catalog JSON..." Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Click="BtnSave_Click" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0"
                                Click="BtnCancel_Click" IsCancel="True"/>
                        <Button x:Name="BtnCreate" Content="RFAGen — create family with types" Style="{StaticResource PrimaryButton}"
                                Click="BtnCreate_Click" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
