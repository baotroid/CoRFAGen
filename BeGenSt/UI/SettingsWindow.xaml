<Window x:Class="BeGenSt.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RFAGen Settings"
        Width="480"
        Height="700"
        MinWidth="360"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Segoe UI">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="RFAGenStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Background="{StaticResource BackgroundBrush}" BorderBrush="#6A7078"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom title bar -->
            <Border Background="#303337" CornerRadius="8,8,0,0"
                    Padding="16,10" MouseDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" VerticalAlignment="Center">
                            <Run Text="RFA"/><Run Text="|" Foreground="{StaticResource AccentBrush}"/><Run Text="Gen"/>
                        </TextBlock>
                        <TextBlock Text="&#x00B7;" FontSize="13"
                                   Foreground="#6A7078" VerticalAlignment="Center"
                                   Margin="10,0"/>
                        <TextBlock Text="Settings" FontSize="11"
                                   Foreground="#FFD27A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Click="BtnClose_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="closeBg" Background="Transparent"
                                        CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="&#x2715;" FontSize="11"
                                               Foreground="#FFD27A"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="closeBg" Property="Background"
                                                Value="#6A7078"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="32,24,32,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Active provider -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Active AI Provider" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider}"/>
                </StackPanel>

                <!-- Claude API Key -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="Anthropic Claude API Key (sk-ant-...)" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ClaudeKeyPasswordBox" Grid.Column="0"
                                     PasswordChanged="ClaudeKeyPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="ClaudeKeyTextBox" Grid.Column="0"
                                 Text="{Binding ClaudeApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"/>
                        <Button x:Name="BtnToggleClaudeKey" Grid.Column="1" Content="Show"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Click="BtnToggleClaudeKey_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Gemini API Key -->
                <StackPanel Grid.Row="4">
                    <TextBlock Text="Google Gemini API Key (AIza...)" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="GeminiKeyPasswordBox" Grid.Column="0"
                                     PasswordChanged="GeminiKeyPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="GeminiKeyTextBox" Grid.Column="0"
                                 Text="{Binding GeminiApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"/>
                        <Button x:Name="BtnToggleGeminiKey" Grid.Column="1" Content="Show"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Click="BtnToggleGeminiKey_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Qwen API Key -->
                <StackPanel Grid.Row="6">
                    <TextBlock Text="Alibaba Qwen API Key (sk-...)" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="QwenKeyPasswordBox" Grid.Column="0"
                                     PasswordChanged="QwenKeyPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="QwenKeyTextBox" Grid.Column="0"
                                 Text="{Binding QwenApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"/>
                        <Button x:Name="BtnToggleQwenKey" Grid.Column="1" Content="Show"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Click="BtnToggleQwenKey_Click"/>
                    </Grid>
                    <TextBlock Text="Qwen endpoint (Base URL, same region as the key)" Margin="0,8,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <TextBox Text="{Binding QwenBaseUrl, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="OpenRouter API Key (sk-or-...) — for Qwen models like qwen/qwen3.8-27b:free" Margin="0,8,0,4"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="OpenRouterKeyPasswordBox" Grid.Column="0"
                                     PasswordChanged="OpenRouterKeyPasswordBox_PasswordChanged"/>
                        <TextBox x:Name="OpenRouterKeyTextBox" Grid.Column="0"
                                 Text="{Binding OpenRouterApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="Collapsed"/>
                        <Button x:Name="BtnToggleOpenRouterKey" Grid.Column="1" Content="Show"
                                Style="{StaticResource GhostButton}"
                                Margin="8,0,0,0"
                                Click="BtnToggleOpenRouterKey_Click"/>
                    </Grid>
                </StackPanel>

                <!-- Model for the active provider -->
                <StackPanel Grid.Row="8">
                    <TextBlock Text="{Binding ModelLabel}" Margin="0,0,0,6" FontWeight="SemiBold"/>
                    <ComboBox IsEditable="True"
                              ItemsSource="{Binding AvailableModels}"
                              Text="{Binding SelectedModel, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                    <TextBlock Text="You can type any model id supported by the provider."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Status -->
                <StackPanel Grid.Row="10">
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>

                <!-- Close button -->
                <StackPanel Grid.Row="12" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Close"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
